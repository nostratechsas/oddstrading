# Dashboard access. Copy to .env.local for development, and set the real values
# in .env.production on the server — never commit them: this repo is public.

# The single demo account allowed into the dashboard.
AUTH_USER=usuario
AUTH_PASSWORD=cambia-esto

# Signs the session cookie. Any long random string; changing it logs everyone
# out. Generate one with:  openssl rand -hex 32
AUTH_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
