# Public site origin — no trailing slash.
# Drives canonical URLs, Open Graph / Twitter tags, robots.txt, sitemap.xml,
# and JSON-LD structured data. Falls back to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=https://example.com

# Origin of the dashboard, a separate app. Leave it blank in development: the
# "Iniciar sesión" link then points at http://localhost:3001, which is where
# `yarn dev` inside dashboard/ listens. Set it in production.
NEXT_PUBLIC_APP_URL=

# --- Server-only (no NEXT_PUBLIC_ prefix — never exposed to the browser) ---

# Optional upstream the /api/contact route forwards leads to (CRM / webhook).
# When unset, the route logs submissions server-side instead.
CONTACT_ENDPOINT=

# Optional upstream orders and payment events are mirrored to (CRM or billing
# webhook). Bookkeeping only — it never blocks the buyer from paying.
CHECKOUT_ENDPOINT=

# --- Pasarela de pagos: ePayco ----------------------------------------------
# Panel de ePayco → Integraciones → Llaves API ("Llaves secretas").
# La cuenta bancaria de destino se configura en ese panel, nunca aquí.
# NUNCA subas estos valores al repositorio.
EPAYCO_CUST_ID=
EPAYCO_P_KEY=
EPAYCO_PUBLIC_KEY=

# "true" mantiene la pasarela en pruebas. Cualquier valor distinto de "false"
# se trata como pruebas: equivocarse hacia el modo real sería el error caro.
EPAYCO_TEST=true

# Solo si tu cuenta usa otro endpoint del que trae por defecto.
EPAYCO_CHECKOUT_URL=

# Margin over the official TRM, as a percentage. `0` charges the TRM exactly,
# which means we absorb every move of the peso between the sale and settlement.
# The TRM moved 1.5% in two days on 5–7 Aug 2026. See decisions-log ADR-0024.
FX_SPREAD_PERCENT=0
